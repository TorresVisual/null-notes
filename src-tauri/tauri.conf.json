{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Null Notes",
  "version": "1.0.11",
  "identifier": "dev.nullnotes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Null Notes",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NDQxODM0ODUyOEQ4NTMKUldSVDJDaUZOQmhFdDU5U3VJOFZ5NlV6Y0RNWkF1OWRUaDdXK0hhS2lQSU1LZ21PTzY4MjUwL1MK",
      "endpoints": [
        "https://github.com/TorresVisual/null-notes/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
